{
  "name": "moneyflow-facebook-research-collector",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "description": "Browser-assisted Facebook research collector with strict root-post body validation, persistent corpus reuse, and assessor-based relevance review.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login": "node src/collect.mjs login",
    "collect": "node src/collect.mjs collect",
    "discover": "node src/topic-discovery.mjs discover",
    "collect:review": "node src/collect.mjs collect",
    "collect:review:legacy": "node src/review-topic-runner.mjs collect",
    "collect:semantic": "node src/semantic-topic-runner.mjs collect",
    "collect:heuristic": "node src/topic-runner.mjs collect",
    "collect:legacy": "node src/index.mjs collect",
    "corpus:import": "node src/import-run.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
