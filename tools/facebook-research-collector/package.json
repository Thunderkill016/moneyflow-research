{
  "name": "moneyflow-facebook-research-collector",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Browser-assisted Facebook research collector with persistent corpus reuse and assessor-based full-body relevance review.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "login": "node src/index.mjs login",
    "collect": "node src/review-topic-runner.mjs collect",
    "collect:semantic": "node src/semantic-topic-runner.mjs collect",
    "collect:heuristic": "node src/topic-runner.mjs collect",
    "collect:legacy": "node src/index.mjs collect",
    "corpus:import": "node src/import-run.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
